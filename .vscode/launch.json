    "version": "0.2.0",
      "configurations": [
      {
        "name": "Vite dev server",
        "type": "node-terminal",
        "request": "launch",
        "command": "npm run dev",
        "cwd": "${workspaceFolder}"
      },
      {
        "name": "Brave: http://localhost:5173",
        "type": "node-terminal",
        "request": "launch",
        "command": "sleep 2; brave http://localhost:5173",
        "cwd": "${workspaceFolder}"
      }
      ],
      "compounds": [
      {
        "name": "Debug React (Vite + Brave)",
        "configurations": ["Vite dev server", "Brave: http://localhost:5173"]
      }
    ]
}